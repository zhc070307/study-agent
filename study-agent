#!/usr/bin/env python3
"""One project entry for the Harness runtime, services and development checks."""
from pathlib import Path
import subprocess
import sys

PROJECT = Path(__file__).resolve().parent
arguments = sys.argv[1:]
command = arguments.pop(0) if arguments and arguments[0] in ('serve', 'web', 'service', 'setup', 'check', 'doctor') else 'serve'
if command == 'doctor':
    raise SystemExit(subprocess.call([sys.executable, str(PROJECT / 'scripts/doctor.py')] + arguments))
if command in ('setup', 'check'):
    raise SystemExit(subprocess.call(['bash', str(PROJECT / 'scripts' / (command + '.sh'))] + arguments))
if command == 'web':
    raise SystemExit(subprocess.call([sys.executable, str(PROJECT / 'packages/agent/web.py')] + arguments))
if command == 'service':
    data = PROJECT / '.data'
    if '--data' in arguments:
        index = arguments.index('--data')
        if index + 1 >= len(arguments):
            raise SystemExit('--data requires an independent study directory')
        data = Path(arguments[index + 1]).resolve()
        del arguments[index:index + 2]
    raise SystemExit(subprocess.call([sys.executable, str(PROJECT / 'packages/learning/study'), '--workspace', str(data)] + arguments))
raise SystemExit(subprocess.call([sys.executable, str(PROJECT / 'packages/agent/run.py')] + arguments))
