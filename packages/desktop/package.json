{
  "name":"study-agent-desktop",
  "version":"0.1.0",
  "private":true,
  "description":"课程文件与学习助理",
  "author":"Study Agent contributors",
  "license":"MIT",
  "main":"main.cjs",
  "scripts":{"build":"electron-builder"},
  "devDependencies":{"electron":"44.7.0","electron-builder":"26.15.3"},
  "build":{
    "appId":"org.studyagent.desktop",
    "productName":"Study Agent",
    "asar":true,
    "directories":{"output":"../../dist/desktop","buildResources":"assets"},
    "files":["main.cjs","boot.html","package.json"],
    "extraResources":[
      {"from":"../../.build/desktop-runtime","to":"runtime"},
      {"from":"../../.build/desktop-python","to":"python"},
      {"from":"../../.build/desktop-tex","to":"tex"},
      {"from":"../../LICENSE","to":"LICENSE"},
      {"from":"../../THIRD_PARTY_NOTICES.md","to":"THIRD_PARTY_NOTICES.md"}
    ],
    "icon":"assets/icon.png",
    "mac":{"target":["dmg"],"category":"public.app-category.education","hardenedRuntime":true,"identity":null,"minimumSystemVersion":"14.0"},
    "win":{"target":[{"target":"nsis","arch":["x64"]}]},
    "nsis":{"oneClick":false,"perMachine":false,"allowToChangeInstallationDirectory":true,"deleteAppDataOnUninstall":false,"createDesktopShortcut":true},
    "artifactName":"Study-Agent-${version}-${os}-${arch}.${ext}",
    "publish":null
  }
}
