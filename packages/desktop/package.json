{
  "name": "study-agent-desktop",
  "version": "0.1.4",
  "private": true,
  "description": "\u8bfe\u7a0b\u6587\u4ef6\u4e0e\u5b66\u4e60\u52a9\u7406",
  "author": "Study Agent contributors",
  "license": "MIT",
  "main": "main.cjs",
  "scripts": {
    "build": "electron-builder --config build-config.cjs"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "org.studyagent.desktop",
    "productName": "Study Agent",
    "asar": true,
    "directories": {
      "output": "../../dist/desktop",
      "buildResources": "assets"
    },
    "files": [
      "main.cjs",
      "boot.html",
      "package.json",
      "preload.cjs",
      "updater.cjs"
    ],
    "extraResources": [
      {
        "from": "../../.build/desktop-runtime",
        "to": "runtime"
      },
      {
        "from": "../../.build/desktop-runtime/node_modules",
        "to": "runtime/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../.build/desktop-python",
        "to": "python"
      },
      {
        "from": "../../.build/desktop-tex",
        "to": "tex"
      },
      {
        "from": "../../LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "../../THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "icon": "assets/icon.png",
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.education",
      "hardenedRuntime": true,
      "identity": "-",
      "minimumSystemVersion": "14.0"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true
    },
    "artifactName": "Study-Agent-${version}-${os}-${arch}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "zhc070307",
      "repo": "study-agent",
      "releaseType": "draft"
    }
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
