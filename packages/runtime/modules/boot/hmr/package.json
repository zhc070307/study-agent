{
  "name": "@deepseek-ai/dsh-hmr",
  "description": "Coordinated module and profile configuration hot reload",
  "version": "0.2.1-alpha.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/boot/hmr"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "author": "Shigma <shigma10826@gmail.com>",
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis-plugin-timer": "workspace:~",
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@deepseek-ai/cordis-plugin-include": "workspace:~",
    "@deepseek-ai/dsh-app-boot": "workspace:*",
    "@deepseek-ai/dsh-cmdline": "workspace:*"
  },
  "dependencies": {
    "@babel/code-frame": "7.29.7",
    "chokidar": "4.0.3",
    "node-addon-require-builtin": "0.1.6",
    "picomatch": "4.0.4",
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-timer": "workspace:~",
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@deepseek-ai/cordis-plugin-include": "workspace:~",
    "@deepseek-ai/dsh-app-boot": "workspace:*",
    "@deepseek-ai/dsh-cmdline": "workspace:*",
    "@deepseek-ai/dsh-atomic-write": "workspace:*"
  },
  "private": true
}
