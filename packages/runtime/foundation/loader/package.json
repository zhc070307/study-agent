{
  "name": "@deepseek-ai/cordis-plugin-loader",
  "description": "Plugin loader for cordis",
  "version": "1.0.6-alpha.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "vendor/loader"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
