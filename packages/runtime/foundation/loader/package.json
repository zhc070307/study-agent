  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "node-addon-require-builtin": "0.1.6"
  },
  "peerDependenciesMeta": {
    "node-addon-require-builtin": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/cosmokit": "workspace:~",
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "private": true
}
